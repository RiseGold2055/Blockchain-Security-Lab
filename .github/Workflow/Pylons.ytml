name: Pylint

on:
  push:
  pull_request:

permissions:
  contents: read

jobs:
  pylint:
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.x"

      - name: Install Pylint
        run: python -m pip install --upgrade pip pylint

      - name: Run Pylint
        run: python -m pylint --disable=R,C *.py
